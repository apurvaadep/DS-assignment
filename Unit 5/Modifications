B. Modify the program to remove a pathway and display the updated matrix.

C. Modify the program degree of each building, program to calculate and display the



#include <iostream>
using namespace std;

const int MAX = 20;

int main()
{
    int graph[MAX][MAX] = {0};
    int n, e, u, v, choice;

    cout << "Enter number of buildings: ";
    cin >> n;

    cout << "Enter number of pathways: ";
    cin >> e;

    cout << "Enter pathway connections:\n";

    for (int i = 0; i < e; i++)
    {
        cin >> u >> v;

        if (u >= 1 && u <= n &&
            v >= 1 && v <= n && u != v)
        {
            graph[u - 1][v - 1] = 1;
            graph[v - 1][u - 1] = 1;
        }
        else
        {
            cout << "Invalid connection!\n";
            i--;
        }
    }

    do
    {
        cout << "\n--- COLLEGE CAMPUS GRAPH ---\n";
        cout << "1. Display Adjacency Matrix\n";
        cout << "2. Add New Building\n";
        cout << "3. Remove Pathway\n";
        cout << "4. Calculate Degree\n";
        cout << "5. Exit\n";
        cout << "Enter choice: ";
        cin >> choice;

        switch (choice)
        {
        case 1:
            cout << "\nAdjacency Matrix:\n";
            for (int i = 0; i < n; i++)
            {
                for (int j = 0; j < n; j++)
                    cout << graph[i][j] << " ";
                cout << endl;
            }
            break;

        case 2:
            if (n >= MAX)
            {
                cout << "Maximum buildings reached.\n";
                break;
            }

            n++;

            for (int i = 0; i < n; i++)
            {
                graph[n - 1][i] = 0;
                graph[i][n - 1] = 0;
            }

            cout << "New building number: " << n << endl;
            cout << "Enter number of connections: ";
            cin >> e;

            if (e < 0 || e >= n)
            {
                cout << "Invalid number of connections.\n";
                break;
            }

            cout << "Enter existing building numbers:\n";

            for (int i = 0; i < e; i++)
            {
                cin >> u;

                if (u >= 1 && u < n)
                {
                    graph[n - 1][u - 1] = 1;
                    graph[u - 1][n - 1] = 1;
                }
                else
                {
                    cout << "Invalid building number.\n";
                    i--;
                }
            }
            cout << "Building added successfully.\n";
            break;

        case 3:
            cout << "Enter two building numbers: ";
            cin >> u >> v;

            if (u >= 1 && u <= n &&
                v >= 1 && v <= n && u != v)
            {
                if (graph[u - 1][v - 1] == 1)
                {
                    graph[u - 1][v - 1] = 0;
                    graph[v - 1][u - 1] = 0;
                    cout << "Pathway removed.\n";
                }
                else
                    cout << "Pathway does not exist.\n";

                cout << "Updated Adjacency Matrix:\n";

                for (int i = 0; i < n; i++)
                {
                    for (int j = 0; j < n; j++)
                        cout << graph[i][j] << " ";
                    cout << endl;
                }
            }
            else
                cout << "Invalid building numbers.\n";
            break;

        case 4:
            cout << "\nDegree of each building:\n";

            for (int i = 0; i < n; i++)
            {
                int degree = 0;

                for (int j = 0; j < n; j++)
                    degree += graph[i][j];

                cout << "Building " << i + 1
                     << " = " << degree << endl;
            }
            break;

        case 5:
            cout << "Program terminated.\n";
            break;

        default:
            cout << "Invalid choice!\n";
        }

    } while (choice != 5);

    return 0;
}
