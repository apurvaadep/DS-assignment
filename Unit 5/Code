Develop a C++ program for a college campus in which each building is represented by a vertex 
and each direct pathway is represented by an edge. Apply an adjacency matrix to store the graph. 
Accept the number of buildings and pathways, create the matrix, display it in row-column form, and and explain 
through the output whether a direct pathway exists between selected buildings




#include <iostream>
using namespace std;

const int MAX = 20;

int main()
{
    int graph[MAX][MAX] = {0};
    int n, e, u, v, choice;

    cout << "Enter number of buildings: ";
    cin >> n;

    cout << "Enter number of pathways: ";
    cin >> e;

    cout << "Enter pathways (building numbers):\n";

    for (int i = 0; i < e; i++)
    {
        cin >> u >> v;
        graph[u - 1][v - 1] = 1;
        graph[v - 1][u - 1] = 1;
    }

    do
    {
        cout << "\n--- COLLEGE CAMPUS GRAPH ---\n";
        cout << "1. Display adjacency matrix\n";
        cout << "2. Check direct pathway\n";
        cout << "3. Add new building\n";
        cout << "4. Remove pathway\n";
        cout << "5. Display degree of buildings\n";
        cout << "6. Exit\n";
        cout << "Enter your choice: ";
        cin >> choice;

        switch (choice)
        {
        case 1:
            cout << "\nAdjacency Matrix:\n";
            for (int i = 0; i < n; i++)
            {
                for (int j = 0; j < n; j++)
                    cout << graph[i][j] << " ";
                cout << endl;
            }
            break;

        case 2:
            cout << "Enter two building numbers: ";
            cin >> u >> v;

            if (u >= 1 && u <= n &&
                v >= 1 && v <= n)
            {
                if (graph[u - 1][v - 1] == 1)
                    cout << "Direct pathway exists.\n";
                else
                    cout << "No direct pathway exists.\n";
            }
            else
                cout << "Invalid building number.\n";
            break;

        case 3:
            if (n >= MAX)
            {
                cout << "Maximum buildings reached.\n";
                break;
            }

            n++;
            cout << "New building number: " << n << endl;

            for (int i = 0; i < n; i++)
                graph[n - 1][i] = graph[i][n - 1] = 0;

            cout << "Enter number of pathways to existing buildings: ";
            cin >> e;

            cout << "Enter existing building numbers:\n";
            for (int i = 0; i < e; i++)
            {
                cin >> u;
                if (u >= 1 && u < n)
                {
                    graph[n - 1][u - 1] = 1;
                    graph[u - 1][n - 1] = 1;
                }
                else
                    cout << "Invalid building number.\n";
            }
            break;

        case 4:
            cout << "Enter pathway buildings to remove: ";
            cin >> u >> v;

            if (u >= 1 && u <= n &&
                v >= 1 && v <= n)
            {
                graph[u - 1][v - 1] = 0;
                graph[v - 1][u - 1] = 0;
                cout << "Pathway removed.\n";
            }
            else
                cout << "Invalid building number.\n";
            break;

        case 5:
            cout << "\nDegree of each building:\n";
            for (int i = 0; i < n; i++)
            {
                int degree = 0;
                for (int j = 0; j < n; j++)
                    degree += graph[i][j];

                cout << "Building " << i + 1
                     << ": " << degree << endl;
            }
            break;

        case 6:
            cout << "Program terminated.\n";
            break;

        default:
            cout << "Invalid choice.\n";
        }

    } while (choice != 6);

    return 0;
}
