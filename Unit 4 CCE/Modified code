#include <iostream>
#include <algorithm>
using namespace std;

int rotations = 0;

struct Node {
    int data, height;
    Node *left, *right;

    Node(int value) {
        data = value;
        height = 1;
        left = right = NULL;
    }
};

int getHeight(Node* n) {
    return (n == NULL) ? 0 : n->height;
}

int balanceFactor(Node* n) {
    if (n == NULL)
        return 0;

    return getHeight(n->left) - getHeight(n->right);
}

void updateHeight(Node* n) {
    n->height = 1 + max(getHeight(n->left),
                        getHeight(n->right));
}

Node* rightRotate(Node* y) {
    cout << "Right rotation at " << y->data << endl;
    rotations++;

    Node* x = y->left;
    Node* t = x->right;

    x->right = y;
    y->left = t;

    updateHeight(y);
    updateHeight(x);

    return x;
}

Node* leftRotate(Node* x) {
    cout << "Left rotation at " << x->data << endl;
    rotations++;

    Node* y = x->right;
    Node* t = y->left;

    y->left = x;
    x->right = t;

    updateHeight(x);
    updateHeight(y);

    return y;
}

Node* insert(Node* root, int key) {
    if (root == NULL)
        return new Node(key);

    if (key < root->data)
        root->left = insert(root->left, key);
    else if (key > root->data)
        root->right = insert(root->right, key);
    else {
        cout << "Duplicate value ignored: " << key << endl;
        return root;
    }

    updateHeight(root);

    int bf = balanceFactor(root);

    // LL case
    if (bf > 1 && key < root->left->data) {
        cout << "LL case" << endl;
        return rightRotate(root);
    }

    // RR case
    if (bf < -1 && key > root->right->data) {
        cout << "RR case" << endl;
        return leftRotate(root);
    }

    // LR case
    if (bf > 1 && key > root->left->data) {
        cout << "LR case" << endl;
        root->left = leftRotate(root->left);
        return rightRotate(root);
    }

    // RL case
    if (bf < -1 && key < root->right->data) {
        cout << "RL case" << endl;
        root->right = rightRotate(root->right);
        return leftRotate(root);
    }

    return root;
}

// Display each node with height and balance factor
void display(Node* root, int space = 0) {
    if (root == NULL)
        return;

    space += 6;

    display(root->right, space);

    cout << endl;

    for (int i = 6; i < space; i++)
        cout << ' ';

    cout << root->data
         << " (H=" << root->height
         << ", BF=" << balanceFactor(root) << ")"
         << endl;

    display(root->left, space);
}

int main() {
    Node* root = NULL;
    int n, value;

    cout << "AVL Tree Construction" << endl;
    cout << "Enter number of elements: ";

    if (!(cin >> n) || n <= 0) {
        cout << "Invalid number of elements." << endl;
        return 1;
    }

    for (int i = 1; i <= n; i++) {
        cout << "\nEnter element " << i << ": ";

        if (!(cin >> value)) {
            cout << "Invalid input." << endl;
            return 1;
        }

        cout << "\nInserting " << value << endl;
        root = insert(root, value);

        cout << "\nTree after insertion:" << endl;
        display(root);

        cout << "\nTotal rotations so far: "
             << rotations << endl;

        cout << "------------------------" << endl;
    }

    cout << "\nFinal AVL Tree:" << endl;
    display(root);

    cout << "\nTotal rotations performed: "
         << rotations << endl;

    return 0;
}
